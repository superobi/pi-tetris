{
  "name": "pi-tetris",
  "version": "1.0.1",
  "description": "Tetris overlay for the pi coding agent. Play while the model works.",
  "license": "MIT",
  "author": "Antoine (@superobi)",
  "repository": { "type": "git", "url": "git+https://github.com/superobi/pi-tetris.git" },
  "homepage": "https://github.com/superobi/pi-tetris#readme",
  "type": "module",
  "keywords": ["pi-package", "pi", "extension", "tetris", "game"],
  "engines": { "node": ">=22.19.0" },
  "files": ["extensions", "README.md", "LICENSE"],
